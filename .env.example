# Copy to .env. Existing process environment variables take precedence.
# Must be an existing absolute directory, separate from this source repository.
WORKSPACE_ROOT=C:\MCPAssignment\demo-workspace
PORT=3000
# Required: private base64url token file OUTSIDE the repository and workspace.
MCP_TOKEN_FILE=C:\MCPAssignment\.mcp-secrets\mcp-token
# Only this additional hostname/origin is admitted; the listener stays loopback.
PUBLIC_HOST=smitten-darkish-many.ngrok-free.dev
# Enable after building and running npm run init:oauth in the restricted token directory.
OAUTH_ENABLED=false
OAUTH_KEY_FILE=C:\MCPAssignment\.mcp-secrets\oauth-keys.json
# Optional: absolute JSON client allowlist OUTSIDE the managed workspace.
# Copy oauth-clients.example.json to the private config directory; add exact ChatGPT setup URLs.
# If unset, only the existing Claude Web identity/callback are trusted.
# OAUTH_CLIENTS_FILE=C:\MCPAssignment\.mcp-secrets\oauth-clients.json
