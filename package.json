{
  "name": "secure-mcp-file-server",
  "version": "0.5.0",
  "private": true,
  "description": "Authenticated MCP editing toolkit with permission profiles and persistent handoffs",
  "type": "module",
  "overrides": {
    "pm2": {
      "js-yaml": "4.3.2",
      "basic-ftp": "6.2.3"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:restart": "pm2 restart secure-mcp-file-server",
    "pm2:stop": "pm2 stop secure-mcp-file-server",
    "init:workspace": "node scripts/init-workspace.mjs",
    "init:oauth": "node --env-file=.env scripts/init-oauth.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^5.1.0",
    "oidc-provider": "9.12.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "9.12.1",
    "pm2": "7.0.4",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
